<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GifTube.Android.MainPage" BackgroundColor="#090611" Shell.NavBarIsVisible="False">
  <ScrollView>
    <VerticalStackLayout Padding="22" Spacing="18">
      <Grid ColumnDefinitions="58,*">
        <Border Background="#A83FD1" StrokeThickness="0" StrokeShape="RoundRectangle 17" HeightRequest="56" WidthRequest="56">
          <Label Text="GIF" FontSize="17" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>
        <VerticalStackLayout Grid.Column="1" Padding="12,0" Spacing="1" VerticalOptions="Center">
          <Label Text="GifTube" FontSize="28" FontAttributes="Bold" TextColor="White"/>
          <Label Text="GIF-библиотека для YouTube" FontSize="12" TextColor="#B8A9C8"/>
        </VerticalStackLayout>
      </Grid>
      <Border Background="#191025" Stroke="#56336E" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="GIF ПРЯМО В КОММЕНТАРИЯХ" TextColor="#E5BFFF" FontSize="13" FontAttributes="Bold"/>
          <Label Text="Открой YouTube, запусти плавающую панель GifTube, выбери анимированную GIF и вставь её в комментарий." TextColor="#F3EAF9" FontSize="13"/>
          <Button Text="✦  ЗАПУСТИТЬ GIF-ПАНЕЛЬ" Clicked="OnStartOverlay" BackgroundColor="#963AC5" TextColor="White" CornerRadius="14" HeightRequest="54" FontAttributes="Bold"/>
          <Label Text="Панель появится поверх YouTube. Её можно закрыть кнопкой ×." TextColor="#A99AB7" FontSize="11"/>
        </VerticalStackLayout>
      </Border>
      <Border Background="#171020" Stroke="#39264B" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
        <VerticalStackLayout Spacing="10">
          <Label Text="НАСТРОЙКА ВСТАВКИ" TextColor="#D9A7FF" FontAttributes="Bold" FontSize="13"/>
          <Label Text="Дополнительное разрешение помогает GifTube находить поле комментария YouTube и вставлять выбранную GIF. Если разрешение не включено, приложение скопирует код — его можно вставить вручную." TextColor="#E9DFF0" FontSize="12"/>
          <Button Text="Включить службу вставки" Clicked="OnAccessibilitySettings" BackgroundColor="#2B1A39" TextColor="White" BorderColor="#70458D" BorderWidth="1" CornerRadius="12" HeightRequest="46"/>
          <Button Text="Разрешить отображение поверх приложений" Clicked="OnOverlaySettings" BackgroundColor="#2B1A39" TextColor="White" BorderColor="#70458D" BorderWidth="1" CornerRadius="12" HeightRequest="46"/>
        </VerticalStackLayout>
      </Border>
      <Border Background="#171020" Stroke="#39264B" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
        <VerticalStackLayout Spacing="7">
          <Label Text="ВАЖНО" TextColor="#D9A7FF" FontAttributes="Bold"/>
          <Label Text="Android не поддерживает установку браузерных расширений внутрь приложения YouTube. Поэтому GifTube использует плавающую панель. Для просмотра анимации у получателя на компьютере должно быть установлено расширение GifTube." TextColor="#BEB0C9" FontSize="11"/>
        </VerticalStackLayout>
      </Border>
      <Label Text="GifTube Android • Floating Picker" TextColor="#756681" FontSize="10" HorizontalOptions="Center"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>