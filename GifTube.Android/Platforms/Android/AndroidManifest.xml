<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <application android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
    <service android:name="com.felexwerd.giftube.GifTubeOverlayService" android:exported="false" />
    <service android:name="com.felexwerd.giftube.GifTubeAccessibilityService"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/giftube_accessibility" />
    </service>
  </application>
</manifest>